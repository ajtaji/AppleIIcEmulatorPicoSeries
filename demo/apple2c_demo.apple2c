; the title on text row 20 and 40 characters of the message on row 22, on the page at off
Procedure DrawText(off.u)
  Protected base.u, s.u
  base = $0650 + off
  For x = 0 To 39
    PokeA(base + x, PeekA(?title + x))
  Next
  base = $0750 + off
  s = scroll
  For x = 0 To 39
    PokeA(base + x, PeekA(?message + s))
    s = s + 1
    If s >= #MSG_LEN
      s = 0
    EndIf
  Next
EndProcedure

Procedure ClearText(off.u)
  Protected r.a, base.u
  For r = 0 To 3
    base = PeekA(?textrow + r) + (PeekA(?textrowhi + r) << 8) + off
    For x = 0 To 39
      PokeA(base + x, $A0)
    Next
  Next
EndProcedure

Procedure Main()
  PokeA($C000, 0)                       ; 80STORE off: PAGE2 shows page 2
  PokeA($C00C, 0)                       ; 40 columns
  PokeA($C00E, 0)                       ; the primary character set
  ClearText($0000)
  ClearText($0400)
  click = PeekA($C056)                  ; lo-res
  click = PeekA($C053)                  ; four lines of text under it
  click = PeekA($C050)                  ; graphics on
  note = 0
  left = PeekA(?tunelen)
  Repeat
    k = t
    If page = 0                         ; page 1 is shown: draw page 2
      Draw20() : Quarter()
      Draw21() : Quarter()
      Draw22() : Quarter()
      Draw23() : Quarter()
      DrawText($0400)
      click = PeekA($C055)
      page = 1
    Else
      Draw10() : Quarter()
      Draw11() : Quarter()
      Draw12() : Quarter()
      Draw13() : Quarter()
      DrawText($0000)
      click = PeekA($C054)
      page = 0
    EndIf
    t = t + 1
    If t >= 10
      t = 0
    EndIf
    cut = cut + 1
    If cut >= 2                         ; the message moves a character every second frame
      cut = 0
      scroll = scroll + 1
      If scroll >= #MSG_LEN
        scroll = 0
      EndIf
    EndIf
    left = left - 1
    If left = 0
      note = note + 1
      If note >= #NOTES
        note = 0
      EndIf
      left = PeekA(?tunelen + note)
    EndIf
  ForEver
EndProcedure

Main()

