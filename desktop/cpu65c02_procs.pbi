  CpuRes = CpuRes & 255
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp(7)
EndProcedure
Procedure OpDF()
; ; $DF BBS5 zpr
  RdB(CpuEa, CpuPC)
  CpuVal = PeekA(CpuZp + CpuEa)
  RdSB(CpuRes, CpuPC + 1)
  CpuPC = (CpuPC + 1) & $FFFF
  If (CpuVal & $20) <> 0
    CpuTmp = (CpuPC + 1) & $FFFF
    CpuPC = (CpuTmp + CpuRes) & $FFFF
    If (CpuTmp ! CpuPC) & $FF00
      CpuLeft = CpuLeft - 2
    Else
      CpuLeft = CpuLeft - 1
    EndIf
  Else
    CpuPC = (CpuPC + 1) & $FFFF
  EndIf
  NextOp(5)
EndProcedure
Procedure OpE0()
; ; $E0 CPX imm
  RdB(CpuVal, CpuPC)
  CpuPC = (CpuPC + 1) & $FFFF
  CpuRes = CpuX - CpuVal
  CpuFN = CpuRes
  CpuFZ = CpuRes & 255
  CpuFC = ~CpuRes
  NextOp(2)
EndProcedure
Procedure OpE1()
; ; $E1 SBC inx
  RdB(CpuTmp, CpuPC)
  CpuPC = (CpuPC + 1) & $FFFF
  CpuTmp = (CpuTmp + CpuX) & 255
  CpuEa = PeekA(CpuZp + CpuTmp) | (PeekA(CpuZp + ((CpuTmp + 1) & 255)) << 8)
  RdB(CpuVal, CpuEa)
  CpuTmp = ((CpuFC >> 8) & 1) ! 1
  CpuRes = CpuA - CpuVal - CpuTmp
  CpuFV = (CpuA ! CpuVal) & (CpuA ! CpuRes)
  CpuFC = ~CpuRes
  If CpuFD
    CpuLeft = CpuLeft - 1
    CpuLo = (CpuA & 15) - (CpuVal & 15) - CpuTmp
    If CpuRes < 0
      CpuRes = CpuRes - $60
    EndIf
    If CpuLo < 0
      CpuRes = CpuRes - 6
    EndIf
  EndIf
  CpuA = CpuRes & 255
  CpuFN = CpuA
  CpuFZ = CpuA
  NextOp(6)
EndProcedure
Procedure OpE2()
; ; $E2 NOP n2
  CpuPC = (CpuPC + 1) & $FFFF
  NextOp(2)
EndProcedure
Procedure OpE3()
; ; $E3 NOP imp
