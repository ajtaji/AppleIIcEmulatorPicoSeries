; ; $04 TSB zp
  RdB(CpuEa, CpuPC)
  CpuPC = (CpuPC + 1) & $FFFF
  CpuVal = PeekA(CpuZp + CpuEa)
  CpuFZ = CpuA & CpuVal
  PokeA(CpuZp + CpuEa, (CpuVal | CpuA))
  NextOp(5)
EndProcedure
