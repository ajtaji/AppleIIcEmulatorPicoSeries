  NextOp(6)
EndProcedure
Procedure Op61()
; ; $61 ADC inx
  RdB(CpuTmp, CpuPC)
  CpuPC = (CpuPC + 1) & $FFFF
  CpuTmp = (CpuTmp + CpuX) & 255
  CpuEa = PeekA(CpuZp + CpuTmp) | (PeekA(CpuZp + ((CpuTmp + 1) & 255)) << 8)
  RdB(CpuVal, CpuEa)
  CpuTmp = (CpuFC >> 8) & 1
  If CpuFD
    CpuLeft = CpuLeft - 1
    CpuLo = (CpuA & 15) + (CpuVal & 15) + CpuTmp
    If CpuLo > 9
      CpuLo = ((CpuLo + 6) & 15) + 16
    EndIf
    CpuRes = (CpuA & $F0) + (CpuVal & $F0) + CpuLo
    CpuFV = (~(CpuA ! CpuVal)) & (CpuA ! CpuRes)
    If CpuRes > $9F
      CpuRes = CpuRes + $60
    EndIf
    ; invalid BCD can take the adjusted sum past $1FF: the carry is "above 255", not bit 8
    If CpuRes > 255
      CpuFC = $100
    Else
      CpuFC = 0
    EndIf
    CpuA = CpuRes & 255
  Else
    CpuRes = CpuA + CpuVal + CpuTmp
    CpuFV = (~(CpuA ! CpuVal)) & (CpuA ! CpuRes)
    CpuFC = CpuRes
    CpuA = CpuRes & 255
  EndIf
  CpuFN = CpuA
  CpuFZ = CpuA
  NextOp(6)
EndProcedure
