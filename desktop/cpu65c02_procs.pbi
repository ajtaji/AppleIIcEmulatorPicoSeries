  RdB(CpuVal, CpuEa)
  CpuRes = (CpuVal << 1) | ((CpuFC >> 8) & 1)
  CpuFC = CpuRes
  CpuRes = CpuRes & 255
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp(6)
