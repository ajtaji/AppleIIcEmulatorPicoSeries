      lsr.w r1, r8, #8
      ldr r2, =global_cpurdmap
      ldr.w r1, [r2, r1, lsl #2]
      cmp r1, #0
      beq.w __ul_cpurun_slowfetch
      ldrb.w r2, [r1, r8]
      add.w r0, r8, #1
      uxth.w r8, r0
      ldr r1, =global_cpudispatch
      ldr.w pc, [r1, r2, lsl #2]
    EndASM
  CompilerElse
    NextOp(7)
  CompilerEndIf
OpFF: ; $FF BBS7 zpr
  RdB(CpuEa, CpuPC)
  CpuVal = PeekA(CpuZp + CpuEa)
  RdSB(CpuRes, CpuPC + 1)
  CpuPC = (CpuPC + 1) & $FFFF
  If (CpuVal & $80) <> 0
    CpuTmp = (CpuPC + 1) & $FFFF
    CpuPC = (CpuTmp + CpuRes) & $FFFF
    If (CpuTmp ! CpuPC) & $FF00
      CpuLeft = CpuLeft - 2
    Else
      CpuLeft = CpuLeft - 1
    EndIf
  Else
    CpuPC = (CpuPC + 1) & $FFFF
  EndIf
  CompilerIf #CPU_TAIL_T2 = 1
    ASM Uses CpuLeft, CpuPC
      subs.w r11, r11, #5
      ble.w __ul_cpurun_done
      lsr.w r1, r8, #8
      ldr r2, =global_cpurdmap
      ldr.w r1, [r2, r1, lsl #2]
      cmp r1, #0
      beq.w __ul_cpurun_slowfetch
      ldrb.w r2, [r1, r8]
      add.w r0, r8, #1
      uxth.w r8, r0
      ldr r1, =global_cpudispatch
      ldr.w pc, [r1, r2, lsl #2]
    EndASM
  CompilerElse
    NextOp(5)
  CompilerEndIf
Done:
  CpuInWindow = 0
  CpuCycles = CpuCycles + CpuBudget - CpuLeft
  ProcedureReturn CpuBudget - CpuLeft
SlowFetch:
  CpuTmp = CpuIoRead(CpuPC)
  CpuPC = (CpuPC + 1) & $FFFF
  Goto CpuDispatch(CpuTmp)
EndProcedure
