      ldr r1, =global_cpudispatch
      ldr.w pc, [r1, r2, lsl #2]
    EndASM
  CompilerElse
    NextOp(1)
  CompilerEndIf
OpFC: ; $FC NOP n3
  CpuPC = (CpuPC + 2) & $FFFF
  CompilerIf #CPU_TAIL_T2 = 1
    ASM Uses CpuLeft, CpuPC
      subs.w r11, r11, #4
      ble.w __ul_cpurun_done
      lsr.w r1, r8, #8
      ldr r2, =global_cpurdmap
      ldr.w r3, [r2, r1, lsl #2]
      cmp r3, #0
      beq.w __ul_cpurun_slowfetch
      ldrb.w r2, [r3, r8]
      add.w r0, r8, #1
      uxth.w r8, r0
      ldr r1, =global_cpudispatch
      ldr.w pc, [r1, r2, lsl #2]
    EndASM
  CompilerElse
    NextOp(4)
  CompilerEndIf
OpFD: ; $FD SBC abx
  CompilerIf #CPU_TAIL_T2 = 1
    ASM Uses CpuPC
      cbz r3, t2op_fd_slow
      uxtb.w r0, r8
      cbz r0, t2op_fd_slow
      cmp r0, #255
      beq t2op_fd_slow
      ldrh.w r0, [r3, r8]
      ldr r1, =global_cpuea
      str r0, [r1]
      b t2op_fd_done
    t2op_fd_slow:
    EndASM
    RdB(CpuEa, CpuPC)
    RdB(CpuTmp, CpuPC + 1)
    CpuEa = CpuEa | (CpuTmp << 8)
    ASM
    t2op_fd_done:
    EndASM
  CompilerElse
    RdB(CpuEa, CpuPC)
    RdB(CpuTmp, CpuPC + 1)
    CpuEa = CpuEa | (CpuTmp << 8)
  CompilerEndIf
  CpuPC = (CpuPC + 2) & $FFFF
  If ((CpuEa & 255) + CpuX) & $100
    CpuLeft = CpuLeft - 1
  EndIf
  CpuEa = CpuEa + CpuX
  RdB(CpuVal, CpuEa)
  CpuTmp = ((CpuFC >> 8) & 1) ! 1
  CpuRes = CpuA - CpuVal - CpuTmp
  CpuFV = (CpuA ! CpuVal) & (CpuA ! CpuRes)
  CpuFC = ~CpuRes
  If CpuFD
    CpuLeft = CpuLeft - 1
    CpuLo = (CpuA & 15) - (CpuVal & 15) - CpuTmp
    If CpuRes < 0
      CpuRes = CpuRes - $60
    EndIf
    If CpuLo < 0
      CpuRes = CpuRes - 6
    EndIf
  EndIf
  CpuA = CpuRes & 255
  CpuFN = CpuA
  CpuFZ = CpuA
  CompilerIf #CPU_TAIL_T2 = 1
    ASM Uses CpuLeft, CpuPC
      subs.w r11, r11, #4
      ble.w __ul_cpurun_done
      lsr.w r1, r8, #8
      ldr r2, =global_cpurdmap
      ldr.w r3, [r2, r1, lsl #2]
      cmp r3, #0
      beq.w __ul_cpurun_slowfetch
      ldrb.w r2, [r3, r8]
      add.w r0, r8, #1
      uxth.w r8, r0
      ldr r1, =global_cpudispatch
      ldr.w pc, [r1, r2, lsl #2]
    EndASM
  CompilerElse
    NextOp(4)
  CompilerEndIf
OpFE: ; $FE INC abx
  CompilerIf #CPU_TAIL_T2 = 1
    ASM Uses CpuPC
      cbz r3, t2op_fe_slow
      uxtb.w r0, r8
      cbz r0, t2op_fe_slow
      cmp r0, #255
      beq t2op_fe_slow
      ldrh.w r0, [r3, r8]
      ldr r1, =global_cpuea
      str r0, [r1]
      b t2op_fe_done
    t2op_fe_slow:
    EndASM
    RdB(CpuEa, CpuPC)
    RdB(CpuTmp, CpuPC + 1)
    CpuEa = CpuEa | (CpuTmp << 8)
    ASM
    t2op_fe_done:
    EndASM
  CompilerElse
    RdB(CpuEa, CpuPC)
    RdB(CpuTmp, CpuPC + 1)
    CpuEa = CpuEa | (CpuTmp << 8)
  CompilerEndIf
  CpuPC = (CpuPC + 2) & $FFFF
  CpuEa = CpuEa + CpuX
  RdB(CpuVal, CpuEa)
  CpuRes = CpuVal + 1
  CpuRes = CpuRes & 255
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  CompilerIf #CPU_TAIL_T2 = 1
    ASM Uses CpuLeft, CpuPC
      subs.w r11, r11, #7
      ble.w __ul_cpurun_done
      lsr.w r1, r8, #8
      ldr r2, =global_cpurdmap
      ldr.w r3, [r2, r1, lsl #2]
      cmp r3, #0
      beq.w __ul_cpurun_slowfetch
      ldrb.w r2, [r3, r8]
      add.w r0, r8, #1
      uxth.w r8, r0
      ldr r1, =global_cpudispatch
      ldr.w pc, [r1, r2, lsl #2]
    EndASM
  CompilerElse
    NextOp(7)
  CompilerEndIf
OpFF: ; $FF BBS7 zpr
  CompilerIf #CPU_TAIL_T2 = 1
    ASM Uses CpuPC
      cbz r3, t2op_ff_slow
      tst.w r8, #255
      beq t2op_ff_slow
      ldrb.w r0, [r3, r8]
      ldr r1, =global_cpuea
      str r0, [r1]
      b t2op_ff_done
    t2op_ff_slow:
    EndASM
    RdB(CpuEa, CpuPC)
    ASM
    t2op_ff_done:
    EndASM
  CompilerElse
    RdB(CpuEa, CpuPC)
  CompilerEndIf
  CpuVal = PeekA(CpuZp + CpuEa)
  RdSB(CpuRes, CpuPC + 1)
  CpuPC = (CpuPC + 1) & $FFFF
  If (CpuVal & $80) <> 0
    CpuTmp = (CpuPC + 1) & $FFFF
    CpuPC = (CpuTmp + CpuRes) & $FFFF
    If (CpuTmp ! CpuPC) & $FF00
      CpuLeft = CpuLeft - 2
    Else
      CpuLeft = CpuLeft - 1
    EndIf
  Else
    CpuPC = (CpuPC + 1) & $FFFF
  EndIf
  CompilerIf #CPU_TAIL_T2 = 1
    ASM Uses CpuLeft, CpuPC
      subs.w r11, r11, #5
      ble.w __ul_cpurun_done
      lsr.w r1, r8, #8
      ldr r2, =global_cpurdmap
      ldr.w r3, [r2, r1, lsl #2]
      cmp r3, #0
      beq.w __ul_cpurun_slowfetch
      ldrb.w r2, [r3, r8]
      add.w r0, r8, #1
      uxth.w r8, r0
      ldr r1, =global_cpudispatch
      ldr.w pc, [r1, r2, lsl #2]
    EndASM
  CompilerElse
    NextOp(5)
  CompilerEndIf
Done:
  CpuInWindow = 0
  CpuCycles = CpuCycles + CpuBudget - CpuLeft
  ProcedureReturn CpuBudget - CpuLeft
SlowFetch:
  CpuTmp = CpuIoRead(CpuPC)
  CpuPC = (CpuPC + 1) & $FFFF
  CompilerIf #CPU_TAIL_T2 = 1
    ; r3 = 0: the handler's operand read takes the slow way (there is no page in r3 to read it from)
    ASM
      movs r3, #0
      ldr r1, =global_cputmp
      ldr r2, [r1]
      ldr r1, =global_cpudispatch
      ldr.w pc, [r1, r2, lsl #2]
    EndASM
  CompilerElse
    Goto CpuDispatch(CpuTmp)
  CompilerEndIf
EndProcedure
