# Apple's ROMs, disk images and the speaker's address never go in git
private/
*.rom
*.ROM
*.dsk
*.DSK
*.do
*.po
*.nib
*.woz
# build output
build/
*.uf2
*.dbg
*.sym
*.sym.meta
*.cycles.txt
*.asm
*.log
*.err
desktop/*.exe
__pycache__/

# the demo's build output (PureMetalForge writes them beside the source)
demo/*.hex
demo/*.bin
demo/*#*
demo/*.txt
demo/build.*

# Klaus Dormann's 6502/65C02 functional tests are GPL, not ours to publish: tools/fetch_tests.py fetches
# them, tools/embed_tests.py builds Diagnostics/test_data.pmi (the board's CPU check) from them
Diagnostics/6502_functional_test.bin
Diagnostics/65C02_extended_opcodes_test.bin
Diagnostics/upstream/65C02_extended_opcodes_test.a65c
Diagnostics/upstream/klaus-LICENSE.txt
Diagnostics/test_data.pmi

# publishing metadata for the repository page (not part of the project)
PUBLISH-META.txt

# this PC's compiler path for tools/board.ps1
tools/board.local.ps1

# published: the ROM-free firmware images and the PureMetal demo's disk (built by PureMetalForge)
!firmware/*.uf2
!demo/apple2c_demo.dsk
