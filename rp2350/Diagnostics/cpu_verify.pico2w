; The 65C02 core's check on the Pico 2 W (RP2350, 150 MHz): Diagnostics/cpu_verify_body.pmi.
#CPU_ASM_TAIL = 1
#CPU_TAIL_T2 = 1                         ; the Thumb-2 tail on the Cortex-M33
#DIAG_CLOCK_KHZ = 150000
#DIAG_BOARD$ = "Pico 2 W"
EnableExplicit
XIncludeFile "RP2350/Lib/clocks.pico2"
XIncludeFile "RP2350/Lib/timer.pico2"
XIncludeFile "RP2350/Lib/uart.pico2"
XIncludeFile "RP2350/Lib/usb_serial.pico2"
XIncludeFile "RP2350/Lib/safety.pico2"
XIncludeFile "../../src/cpu65c02.pmi"
XIncludeFile "../../Diagnostics/test_data.pmi"
XIncludeFile "../../Diagnostics/cpu_verify_body.pmi"
Main()
